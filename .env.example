# API origin only (no /api, no /health). Trailing slashes are stripped.
#
# Local dev: copy to .env.development (or .env.development.local).
# Docker / Railway image build: set the same name VITE_API_BASE_URL on the service
# so the Dockerfile ARG is filled (see Dockerfile); .env.production is not copied into the image.
#
VITE_API_BASE_URL=http://localhost:4001
